  ],
  "sort": {
    "keys": ["escalationGrade:desc", "status:asc", "id:asc"],
    "statusOrder": ["CONFIRMED", "UNVERIFIED", "NOT_ASSESSABLE"],
    "forbiddenKeys": ["assetImpactGrade"]
  },
  "sectionOrder": ["ESCALATION", "EXPOSURE", "RECON", "DESTRUCTIVE"],

[Unit]
Description=opt-SolutionDashboard - IAM governance approval and failure dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opt-dashboard
Group=opt-dashboard
WorkingDirectory=/opt/opt-dashboard

# Credentials come from the instance profile. There is no credentials file and no key in the
# environment, so a compromise of this host yields a role that can list and read two buckets and
# write one prefix - no ecs:RunTask, no iam:PassRole, and no delete anywhere.
EnvironmentFile=/etc/opt-dashboard/dashboard.env
ExecStart=/usr/bin/node /opt/opt-dashboard/server/index.js

Restart=always
RestartSec=5

# Nothing is mid-write that matters: a decision is a single PutObject that has either happened or
# not, so a short stop window costs nothing.
KillSignal=SIGTERM
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# No ReadWritePaths. This process writes nothing to disk - the state it cares about is in S3 and
# the log goes to the journal - so a writable path would only be somewhere for something else to
# end up.

# The instance metadata service is how the role is obtained, so it has to stay reachable. Nothing
# else outbound is needed beyond S3.
IPAddressDeny=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=opt-dashboard

[Install]
WantedBy=multi-user.target

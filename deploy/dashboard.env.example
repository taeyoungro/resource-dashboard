# /etc/opt-dashboard/dashboard.env
#
# Reference copy. Refreshed by install.sh on every install, so it tracks the code; the real file
# beside it is never touched.
#
# There is no AWS_ACCESS_KEY_ID here and there must never be one. The role arrives through the
# instance profile opt-SolutionDashboard, which is what makes this host's permissions readable
# from CloudFormation rather than from a file somebody put here.

# ---- required ---------------------------------------------------------------------------------

# The marker bucket. Both prefixes are read from it; applier/ is written to.
OPT_MARKER_BUCKET=opt-solution-markers

# The terraform state bucket. Only its plans/ prefix is read - the role's s3:ListBucket carries a
# condition limiting it to that prefix, so a listing of anything else is denied rather than empty.
OPT_STATE_BUCKET=opt-org-policy-terraform-state

# The shared key the page sends as X-API-Key. At least 32 characters or the server refuses to
# start. Generate one, do not invent one:
#
#   openssl rand -hex 32
#
# This is a gate, not an identity: it says the caller had the secret, not who they are. The
# reviewer recorded on a decision is self-asserted until something in front of this server
# establishes a person.
OPT_DASHBOARD_API_KEY=

# ---- optional -------------------------------------------------------------------------------

AWS_REGION=us-east-1

# Loopback by default, because this server speaks plain HTTP and holds no certificate. Reach it
# through an SSH tunnel, or put nginx in front and terminate TLS there. Setting this to 0.0.0.0
# puts the API key on the wire in clear on every request - it is a decision, not a default.
OPT_BIND_ADDRESS=127.0.0.1
OPT_PORT=8080

# A marker exists while its task runs. Below this age it is reported as running rather than as a
# failure, so a plan that is three minutes into terraform init does not read as broken.
OPT_MARKER_GRACE_SECONDS=900

# The sweep is what makes the notification path optional: a lost notification costs at most one
# interval. It also runs once at startup, so a replaced instance is correct immediately.
OPT_SWEEP_INTERVAL_SECONDS=86400

# Marker bodies FETCHED per sweep, oldest first - bodies already held by the cache above do not
# count against it. A bucket that has accumulated failures should not turn one sweep into thousands
# of GetObject calls; whatever is skipped is still listed, and the page says how many were skipped.
OPT_MAX_BODIES_PER_SWEEP=200

# Where the built page is. Set by install.sh; only change it if the layout changes.
OPT_STATIC_DIR=/opt/opt-dashboard/dist

# ---- accepting announcements from the listener (optional) ---------------------------------------
#
# A second key, for exactly one route: POST /api/notifications. Unset means announcements are off
# and that route answers 503 rather than being open.
#
# It MUST differ from OPT_DASHBOARD_API_KEY, and the process refuses to start if it does not. That
# key approves plans; this one is held by a machine that consumes a queue, and merging them would
# give the listener the ability to approve IAM changes. A leak of the ingest key buys noise in a
# panel: an announcement is not a state, and the next sweep contradicts anything fabricated.
#
# At least 32 characters. Must equal OPT_DASHBOARD_INGEST_KEY on the listener host.
#   openssl rand -hex 32
OPT_DASHBOARD_INGEST_KEY=

# How many announcements the panel keeps, and how often one may trigger a sweep. A burst of
# dispatches is normal - one administrator attaching five policies - and should not become a burst
# of full bucket listings.
OPT_NOTIFICATION_LIMIT=200
OPT_NOTIFICATION_SWEEP_SECONDS=10

# Marker bodies kept in memory so the sweep does not fetch them again.
#
# The sweep asks two things with two costs: which markers exist is one listing, and what each one
# is about was a GetObject per marker - which is the only reason OPT_MAX_BODIES_PER_SWEEP exists.
# Two of the three writers hand this process the body for free: the listener announces inspector
# markers with theirs, and the approval markers are ones this process wrote itself. So a healthy
# sweep makes no GetObject on the marker bucket at all.
#
# A miss costs one call and gives the same answer. Bodies reach ten kilobytes, so this count is
# the memory bound - 200 entries is a few megabytes.
OPT_MARKER_BODY_CACHE=200

# The largest announcement this will accept. The marker body travels inside it, and the listener
# leaves the body out above its own OPT_DASHBOARD_MAX_BYTES (default 64 KB) rather than sending
# something this would refuse - so this only has to be the larger of the two.
OPT_MAX_ANNOUNCEMENT_BYTES=131072

# ---- the risk analysis ------------------------------------------------------------------------
#
# What this deployment's own resources are called. Used to tell a write against the governance
# machinery apart from a write against an ordinary workload: an item written into the approval
# store, a forged lock, an image swapped in the pipeline's cluster - each of those reads as "a
# DynamoDB table" or "an EC2 cluster" and ranks below a production database unless something says
# otherwise.
#
# Naming them here is a statement of CONFIGURATION, not a guess from a name. That distinction is
# the whole reason these are variables: a deployment that renamed a resource sets its name here,
# and a table merely CALLED opt-approval-store in somebody else's account is not matched.
#
# All optional - each defaults to what the CloudFormation templates default to, so a stock
# deployment needs none of them. Getting one wrong costs analysis quality and nothing else.
OPT_APPROVAL_TABLE=opt-approval-store
OPT_LOCK_TABLE=opt-tf-state-lock
OPT_INLINE_STATE_BUCKET=opt-inlinepolicy-terraform
OPT_EVENT_QUEUE=opt-iam-event-queue
OPT_CLUSTER=opt-solution-cluster

# Resources no configuration can name, declared by hand. Comma separated, each "<arn>" or
# "<arn>|<label>".
#
# EC2 instances are the case this exists for. The machines running the listener and this dashboard
# carry no name this deployment set, so they are invisible to the analysis until they are declared
# - and taking one over takes over the role already attached to it, without needing iam:PassRole at
# all. Undeclared, the analysis reports that it could not rank instance takeover rather than
# reporting that there is none.
#
#   OPT_CONTROL_PLANE_ARNS=arn:aws:ec2:us-east-1:718100330247:instance/i-0aaa|listener_host,arn:aws:ec2:us-east-1:718100330247:instance/i-0bbb|dashboard_host
OPT_CONTROL_PLANE_ARNS=

# ---- the risk analysis --------------------------------------------------------------------------
#
# Off unless asked for. Turning it on spends money on every analysis and needs the Bedrock grant in
# opt-stack-dashboard-host.yaml, which an older deployment of that stack does not carry - so a
# dashboard that started calling a model on its own would either bill for something nobody chose or
# fail with AccessDenied on the one screen an approver is waiting on.
#
# Off does not mean no analysis. The twelve rules in server/finding-rules.json are deterministic,
# cost nothing and always run; what this switch adds is a model judging the candidate paths the code
# proposed. Set it to "on" to enable, anything else leaves it off.
OPT_RISK_ANALYSIS=

# What to pass Bedrock as the model id. Claude Sonnet 4.6, and this deployment is built for it
# alone.
#
# This is the INFERENCE PROFILE id, not the bare model id. Sonnet 4.6 is offered through
# cross-region inference rather than on-demand throughput, so a call passing
# anthropic.claude-sonnet-4-6 on its own fails with a 400 telling you to pass a profile.
#
#   us.        regional routing, ten percent more per token, and a grant that lists three regions
#   global.    dynamic routing, no premium, and a grant that cannot enumerate where it may route
#
# It must match what the stack granted. The grant names the profile ARN and the foundation model in
# the regions the profile routes to, and nothing else in Bedrock - so changing this value alone
# produces AccessDenied, not a silent fallback to another model. Another model needs all of:
# its own agreement on the account, RiskAnalysisInferenceProfileId and RiskAnalysisModelId changed
# in opt-stack-dashboard-host and the stack re-applied, and confirmation that it honours a FORCED
# TOOL CALL - which is how the answer schema is carried. A model that ignores one returns prose,
# and that batch is recorded as failed rather than parsed loosely.
#
# What the Converse route does not carry: prompt caching, because Converse accepts a cache point on
# some models and refuses it with a 400 on others. The frame and the assessment digest are therefore
# paid for on every batch, and the usage line on the analysis says what that cost. Adaptive thinking
# does ride along, and is dropped with one retry if the endpoint refuses it.
OPT_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# What the run's wall clock is made of.
#
# The time is OUTPUT. A verdict is a Korean narrative, a containment block and seven answers - call
# it five hundred tokens - so a batch of ten is five thousand tokens generated in series. Measured
# on six policies and twenty-two candidates: batches of ten, sent one after another, took about two
# minutes. Four per batch with six in flight puts the same run under twenty seconds, because the
# run then takes as long as its SLOWEST batch instead of the sum of all of them.
#
# Raising the batch or lowering the concurrency both make it longer. What you buy by lowering the
# concurrency is fewer throttles: these requests share one account's token budget, and a throttle is
# retried with backoff, which spends the time it saved.
#
# The token ceiling bounds the answer, not the question. It is per batch, so it does not need to
# come down when the batch does.
OPT_RISK_ANALYSIS_MAX_TOKENS=16000
OPT_RISK_ANALYSIS_BATCH=4
OPT_RISK_ANALYSIS_CONCURRENCY=6

# When to stop STARTING batches. Not a cancel - a batch already in flight was paid for and is read.
# Batches never started are reported on the page by the candidates they would have covered, so an
# approver knows which went unasked rather than reading their absence as "the model found nothing".
# 0 turns the bound off, and then a slow day has no ceiling at all.
OPT_RISK_ANALYSIS_DEADLINE_SECONDS=60
